{
  "name": "lasso-x-list-assigner",
  "version": "0.2.0",
  "private": true,
  "description": "Add people to your X Lists from the timeline — select posts and file their authors without leaving the feed.",
  "type": "module",
  "scripts": {
    "qa": "bun --no-env-file tools/qa/run.mjs",
    "qa:check": "bun --no-env-file tools/qa/self-check.mjs",
    "qa:browser": "bun --no-env-file tools/qa/run.mjs browser",
    "qa:smoke": "bun --no-env-file tools/qa/run.mjs smoke",
    "qa:setup": "bun --no-env-file tools/qa/run.mjs setup",
    "qa:doctor": "bun --no-env-file tools/qa/run.mjs doctor",
    "prepare": "varlock codegen",
    "env:check": "varlock load",
    "env:scan": "varlock scan",
    "dev": "vite",
    "build": "if [ -n \"$NO_COLOR\" ]; then unset FORCE_COLOR; fi; vite build",
    "icons": "node scripts/build-icons.mjs",
    "typecheck": "tsc --noEmit && tsc -p convex/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src tests convex e2e scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "e2e": "bun run build && playwright test",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@preact/signals": "^2.11.3",
    "@preact/signals-core": "^1.14.4",
    "@stylexjs/stylex": "^0.19.1",
    "convex": "^1.46.0",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@stylexjs/unplugin": "^0.19.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/chrome": "^0.3.4",
    "@varlock/vite-integration": "^1.5.2",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.14.0",
    "convex-test": "^0.0.60",
    "dependency-cruiser": "^18.5.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "next",
    "varlock": "^1.21.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
