# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Convex deployment ID used by `convex dev` CLI
CONVEX_DEPLOYMENT=

# Convex Mirror deployment URL
# @type=url
VITE_CONVEX_URL=

# Convex HTTP site URL
# @type=url
VITE_CONVEX_SITE_URL=

# Mirror device key for local dev build
# @sensitive
VITE_LASSO_DEVICE_KEY=

# Secret device key used on Convex backend deployment
# @sensitive
LASSO_DEVICE_KEY=
